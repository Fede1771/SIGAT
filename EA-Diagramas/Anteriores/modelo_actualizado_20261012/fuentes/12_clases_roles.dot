digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.55", ranksep="0.7", splines=polyline, dpi=72];
node [fontname="Arial", fontsize=12, color="#404040"];
edge [fontname="Arial", fontsize=9, color="#555555", arrowsize=0.8];
"FormGestionRoles" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>FormGestionRoles</B></TD></TR><TR><TD ALIGN="LEFT">-AsignarAUsuario(): void<BR ALIGN="LEFT"/>-QuitarAUsuario(): void<BR ALIGN="LEFT"/>-AsignarARol(): void<BR ALIGN="LEFT"/>-QuitarDeRol(): void<BR ALIGN="LEFT"/>-EditarFamilia(): void<BR ALIGN="LEFT"/>-Ejecutar(accion: Action): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"RolesBLL" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>RolesBLL</B></TD></TR><TR><TD ALIGN="LEFT">+CargarParaGestion(): EstadoRoles<BR ALIGN="LEFT"/>+CargarRolesUsuario(usuario: Usuario): void<BR ALIGN="LEFT"/>+Guardar(estado: EstadoRoles): void<BR ALIGN="LEFT"/><U>+Validar(estado: EstadoRoles): void</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"RolesDAL" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>RolesDAL</B></TD></TR><TR><TD ALIGN="LEFT">+Cargar(): EstadoRoles<BR ALIGN="LEFT"/>+Guardar(estado: EstadoRoles): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"EstadoRoles" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>EstadoRoles</B></TD></TR><TR><TD ALIGN="LEFT">+Version: long<BR ALIGN="LEFT"/>+IdAdministradorOriginal: int<BR ALIGN="LEFT"/>+Roles: List&lt;Rol&gt;<BR ALIGN="LEFT"/>+Permisos: List&lt;Permiso&gt;<BR ALIGN="LEFT"/>+Usuarios: List&lt;Usuario&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Usuario" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>Usuario</B></TD></TR><TR><TD ALIGN="LEFT">+EsAdministradorOriginal: bool<BR ALIGN="LEFT"/>+Id: int<BR ALIGN="LEFT"/>+Roles: List&lt;Rol&gt;<BR ALIGN="LEFT"/>+IdUsuario: int<BR ALIGN="LEFT"/>+NombreUsuario: string<BR ALIGN="LEFT"/>+Password: string<BR ALIGN="LEFT"/>+Nombre: string<BR ALIGN="LEFT"/>+Apellido: string<BR ALIGN="LEFT"/>+Activo: bool<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+AsignarRol(r: Rol): void<BR ALIGN="LEFT"/>+QuitarRol(r: Rol): void<BR ALIGN="LEFT"/>+TienePermiso(nombre: string): bool<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Rol" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>Rol</B></TD></TR><TR><TD ALIGN="LEFT">+Id: int<BR ALIGN="LEFT"/>+Nombre: string<BR ALIGN="LEFT"/>+Roles: List&lt;Rol&gt;<BR ALIGN="LEFT"/>+Permisos: List&lt;Permiso&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ContieneRol(buscado: Rol): bool<BR ALIGN="LEFT"/>+AgregarRol(rol: Rol): void<BR ALIGN="LEFT"/>+QuitarRol(rol: Rol): void<BR ALIGN="LEFT"/>+AgregarPermiso(permiso: Permiso): void<BR ALIGN="LEFT"/>+QuitarPermiso(permiso: Permiso): void<BR ALIGN="LEFT"/>+TienePermiso(nombre: string): bool<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Permiso" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>Permiso</B><BR/>«abstract»</TD></TR><TR><TD ALIGN="LEFT">+Id: int<BR ALIGN="LEFT"/>+Nombre: string<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ContienePermiso(nombre: string): bool<BR ALIGN="LEFT"/>+Agregar(permiso: Permiso): void<BR ALIGN="LEFT"/>+Quitar(permiso: Permiso): void<BR ALIGN="LEFT"/>+ObtenerHijos(): List&lt;Permiso&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"PermisoSimple" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>PermisoSimple</B></TD></TR><TR><TD ALIGN="LEFT">+ContienePermiso(nombre: string): bool<BR ALIGN="LEFT"/>+Agregar(permiso: Permiso): void<BR ALIGN="LEFT"/>+Quitar(permiso: Permiso): void<BR ALIGN="LEFT"/>+ObtenerHijos(): List&lt;Permiso&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"PermisoCompuesto" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>PermisoCompuesto</B></TD></TR><TR><TD ALIGN="LEFT">+Agregar(permiso: Permiso): void<BR ALIGN="LEFT"/>+Quitar(permiso: Permiso): void<BR ALIGN="LEFT"/>+ObtenerHijos(): List&lt;Permiso&gt;<BR ALIGN="LEFT"/>+ContienePermiso(nombre: string): bool<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"MatrizRoles" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>MatrizRoles</B><BR/>«static»</TD></TR><TR><TD ALIGN="LEFT"><U>+CrearCatalogo(): EstadoRoles</U><BR ALIGN="LEFT"/><U>+ValidarCatalogo(estado: EstadoRoles): void</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"PermisoCompuesto" -> "Permiso" [arrowhead=empty];
"PermisoCompuesto" -> "Permiso" [arrowhead=vee,label="hijos",taillabel="1",headlabel="0..*"];
"PermisoSimple" -> "Permiso" [arrowhead=empty];
"Rol" -> "Permiso" [arrowhead=vee,label="permisos",taillabel="1",headlabel="0..*"];
