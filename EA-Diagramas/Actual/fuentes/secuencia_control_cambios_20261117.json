    {
      "note": "2. RESTAURAR LA VERSION SELECCIONADA\nEl botón se habilita solo si la versión representa una cuenta existente y difiere del estado actual. La confirmación informa que se creará una versión nueva y se conservará la contraseña actual. Responder No finaliza sin escritura SQL.",
      "height": 300,
      "rect": [
        2670,
        665,
        850,
        300
      ]
    },
    {
      "a": "admin",
      "b": "ui",
      "text": "Seleccionar versión y pulsar Restaurar",
      "reply": false
    },
    {
      "a": "ui",
      "b": "admin",
      "text": "Solicitar confirmación",
      "reply": false
    },
    {
      "a": "admin",
      "b": "ui",
      "text": "[Sí] Confirmar restauración",
      "reply": true
    },
    {
      "a": "ui",
      "b": "bll",
      "text": "RestaurarVersion(idUsuario, numero, versionSeguridad)",
      "reply": false
    },
