"GestionUsuariosFactory" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>GestionUsuariosFactory</B></TD></TR><TR><TD ALIGN="LEFT">#CrearEvento(): IBitacoraEvento<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
