digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.55", ranksep="0.7", splines=polyline, dpi=72];
node [fontname="Arial", fontsize=12, color="#404040"];
edge [fontname="Arial", fontsize=9, color="#555555", arrowsize=0.8];
"FrmPrincipal" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>FrmPrincipal</B></TD></TR><TR><TD ALIGN="LEFT">-ItemLogout_Click(sender: Object, e: EventArgs): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"SesionServicio" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>SesionServicio</B><BR/>«singleton»</TD></TR><TR><TD ALIGN="LEFT">+UsuarioActual: Usuario<BR ALIGN="LEFT"/>+EstaAutenticado: bool<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT"><U>+ObtenerInstancia(): SesionServicio</U><BR ALIGN="LEFT"/>+IniciarSesion(usuarioLogueado: Usuario): void<BR ALIGN="LEFT"/>+CerrarSesion(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"IdiomaManager" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>IdiomaManager</B><BR/>«singleton»</TD></TR><TR><TD ALIGN="LEFT">+IdiomaActual: Idioma<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ReiniciarSesion(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"BitacoraBLL" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>BitacoraBLL</B></TD></TR><TR><TD ALIGN="LEFT">+Registrar(evento: IBitacoraEvento): void<BR ALIGN="LEFT"/>+Registrar(usuario: string, actividad: string, informacion: string): void<BR ALIGN="LEFT"/>+Buscar(desde: Nullable&lt;DateTime&gt;, hasta: Nullable&lt;DateTime&gt;, usuario: string, actividad: string): List&lt;Bitacora&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"BitacoraDAL" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>BitacoraDAL</B></TD></TR><TR><TD ALIGN="LEFT">+Insertar(registro: Bitacora): void<BR ALIGN="LEFT"/>+Buscar(desde: Nullable&lt;DateTime&gt;, hasta: Nullable&lt;DateTime&gt;, usuario: string, actividad: string): List&lt;Bitacora&gt;<BR ALIGN="LEFT"/>+VerificarIntegridadBaseDatos(): bool<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"IntegridadDAL" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>IntegridadDAL</B></TD></TR><TR><TD ALIGN="LEFT">+Verificar(): InformeIntegridad<BR ALIGN="LEFT"/>+LeerVerificado(leer: Func&lt;SqlConnection, SqlTransaction, T&gt;): T<BR ALIGN="LEFT"/>+Cambiar(tabla: string, cambiar: Func&lt;SqlConnection, SqlTransaction, T&gt;): T<BR ALIGN="LEFT"/>+PuedeAdministrar(): bool<BR ALIGN="LEFT"/>+ArchivarBitacora(dias: int): int<BR ALIGN="LEFT"/>+InicializarBaseConfiable(): string<BR ALIGN="LEFT"/>+CrearRespaldoConfiable(destino: string): string<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"FrmLogin" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>FrmLogin</B></TD></TR></TABLE>>];
"BitacoraBLL" -> "BitacoraDAL" [arrowhead=vee,label="_dal",taillabel="1",headlabel="1"];
"BitacoraDAL" -> "IntegridadDAL" [arrowhead=vee,label="integridad",taillabel="1",headlabel="1"];
"FrmPrincipal" -> "BitacoraBLL" [arrowhead=vee,label="_bitacora",taillabel="1",headlabel="1"];
