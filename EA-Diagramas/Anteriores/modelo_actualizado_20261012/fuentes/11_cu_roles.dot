digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.55", ranksep="0.7", splines=polyline, dpi=72];
node [fontname="Arial", fontsize=12, color="#404040"];
edge [fontname="Arial", fontsize=9, color="#555555", arrowsize=0.8];
"actor" [shape=plaintext, label="«actor»\nAdministrador"];
"uc0" [shape=ellipse, style=filled, fillcolor="#edf2f7", label="CU04 Asignar o quitar rol a un usuario"];
"uc1" [shape=ellipse, style=filled, fillcolor="#edf2f7", label="Asignar o quitar componentes de un rol"];
"uc2" [shape=ellipse, style=filled, fillcolor="#edf2f7", label="Editar una familia de permisos"];
"actor" -> "uc0" [dir=none];
"actor" -> "uc1" [dir=none];
"actor" -> "uc2" [dir=none];
}