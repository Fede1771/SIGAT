digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.55", ranksep="0.7", splines=polyline, dpi=72];
node [fontname="Arial", fontsize=12, color="#404040"];
edge [fontname="Arial", fontsize=9, color="#555555", arrowsize=0.8];
"IdiomaManager" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>IdiomaManager</B><BR/>«singleton»</TD></TR><TR><TD ALIGN="LEFT">+IdiomaActual: Idioma<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ReiniciarSesion(): void<BR ALIGN="LEFT"/><U>+ObtenerInstancia(): IdiomaManager</U><BR ALIGN="LEFT"/>+Suscribir(observador: IIdiomaObserver): void<BR ALIGN="LEFT"/>+Desuscribir(observador: IIdiomaObserver): void<BR ALIGN="LEFT"/>+NotificarObservadores(): void<BR ALIGN="LEFT"/>+CargarIdioma(idioma: Idioma, traducciones: Dictionary&lt;string, string&gt;): void<BR ALIGN="LEFT"/>+Traducir(nombreForm: string, nombreControl: string, textoOriginal: string): string<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"IIdiomaSubject" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>IIdiomaSubject</B><BR/>«interface»</TD></TR><TR><TD ALIGN="LEFT">+Suscribir(observador: IIdiomaObserver): void<BR ALIGN="LEFT"/>+Desuscribir(observador: IIdiomaObserver): void<BR ALIGN="LEFT"/>+NotificarObservadores(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"IIdiomaObserver" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>IIdiomaObserver</B><BR/>«interface»</TD></TR><TR><TD ALIGN="LEFT">+ActualizarIdioma(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"IdiomaBLL" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>IdiomaBLL</B></TD></TR><TR><TD ALIGN="LEFT">+ObtenerIdiomas(): List&lt;Idioma&gt;<BR ALIGN="LEFT"/>+ObtenerTodosLosIdiomas(): List&lt;Idioma&gt;<BR ALIGN="LEFT"/>+CambiarIdioma(idIdioma: int): void<BR ALIGN="LEFT"/>+RestablecerIdiomaUsuario(): void<BR ALIGN="LEFT"/>+CrearIdioma(nombre: string, codigo: string, nombreNativo: string, activo: bool): int<BR ALIGN="LEFT"/>+CambiarEstadoIdioma(idIdioma: int, activo: bool): void<BR ALIGN="LEFT"/>+ObtenerTraduccionesParaGestion(idIdioma: int): List&lt;Traduccion&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"IdiomaDAL" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>IdiomaDAL</B></TD></TR><TR><TD ALIGN="LEFT">+ObtenerIdiomaPreferido(idUsuario: int): Nullable&lt;int&gt;<BR ALIGN="LEFT"/>+GuardarIdiomaPreferido(idUsuario: int, idIdioma: int): void<BR ALIGN="LEFT"/>+ObtenerIdiomaPorId(idIdioma: int): Idioma<BR ALIGN="LEFT"/>+ObtenerTraduccionesPorIdioma(idIdioma: int): List&lt;Traduccion&gt;<BR ALIGN="LEFT"/>+ActualizarTraduccion(idIdioma: int, idControl: int, texto: string, estado: string, digitoVerificador: string): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Idioma" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>Idioma</B></TD></TR><TR><TD ALIGN="LEFT">+Id: int<BR ALIGN="LEFT"/>+Nombre: string<BR ALIGN="LEFT"/>+Codigo: string<BR ALIGN="LEFT"/>+NombreNativo: string<BR ALIGN="LEFT"/>+Activo: bool<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ToString(): string<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Traduccion" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>Traduccion</B></TD></TR><TR><TD ALIGN="LEFT">+IdIdioma: int<BR ALIGN="LEFT"/>+IdControl: int<BR ALIGN="LEFT"/>+Texto: string<BR ALIGN="LEFT"/>+DigitoVerificador: string<BR ALIGN="LEFT"/>+ControlNombre: string<BR ALIGN="LEFT"/>+FormNombre: string<BR ALIGN="LEFT"/>+Estado: string<BR ALIGN="LEFT"/>+TextoBase: string<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ControlIdioma" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>ControlIdioma</B></TD></TR><TR><TD ALIGN="LEFT">+Id: int<BR ALIGN="LEFT"/>+Control: string<BR ALIGN="LEFT"/>+Form: string<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"TraductorFormularios" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>TraductorFormularios</B><BR/>«static»</TD></TR><TR><TD ALIGN="LEFT"><U>+TraducirFormulario(formulario: Form): void</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"FrmPrincipal" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>FrmPrincipal</B></TD></TR><TR><TD ALIGN="LEFT">+ActualizarIdioma(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"FrmGestionIdiomas" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>FrmGestionIdiomas</B></TD></TR><TR><TD ALIGN="LEFT">+ActualizarIdioma(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"IdiomaBLL" -> "IdiomaDAL" [arrowhead=vee,label="_dal",taillabel="1",headlabel="1"];
"IdiomaManager" -> "IIdiomaSubject" [arrowhead=empty,style=dashed];
"IdiomaManager" -> "IIdiomaObserver" [arrowhead=vee,label="observadores",taillabel="1",headlabel="0..*"];
"FrmGestionIdiomas" -> "IIdiomaObserver" [arrowhead=empty,style=dashed];
"FrmGestionIdiomas" -> "IdiomaBLL" [arrowhead=vee,label="_idiomaBLL",taillabel="1",headlabel="1"];
"FrmGestionIdiomas" -> "Traduccion" [arrowhead=vee,label="_traduccionesActuales",taillabel="1",headlabel="0..*"];
"FrmPrincipal" -> "IIdiomaObserver" [arrowhead=empty,style=dashed];
"FrmPrincipal" -> "IdiomaBLL" [arrowhead=vee,label="_idiomaBLL",taillabel="1",headlabel="1"];
"TraductorFormularios" -> "IdiomaBLL" [arrowhead=vee,label="_idiomaBLL",taillabel="1",headlabel="1"];
"IdiomaManager" -> "Idioma" [arrowhead=vee,label="IdiomaActual",taillabel="1",headlabel="0..1"];
"IdiomaBLL" -> "IdiomaManager" [arrowhead=vee,style=dashed,label="CargarIdioma"];
"TraductorFormularios" -> "IdiomaManager" [arrowhead=vee,style=dashed,label="Traducir"];
}