digraph SIGAT {
graph [rankdir=LR, bgcolor="white", nodesep="0.35", ranksep="1.15", pad="0.2", splines=polyline, outputorder=edgesfirst, fontname="Arial", fontsize=13];
node [shape=plain, fontname="Arial", fontsize=11];
edge [fontname="Arial", fontsize=9, color="#64748b", fontcolor="#42536b", arrowsize=0.8];
subgraph cluster_0 { label="SIGAT.SERVICIOS"; color="#c5d0de"; style="rounded"; margin=18;
n0 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#8493a5"><TR><TD BGCOLOR="#e3f3f4" ALIGN="CENTER"><FONT POINT-SIZE="10">clase</FONT><BR/><B>EncriptadorServicio</B></TD></TR><HR/><TR><TD ALIGN="LEFT" CELLPADDING="4">- _iv: byte[]</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">- _key: byte[]</TD></TR><HR/><TR><TD ALIGN="LEFT" CELLPADDING="4">+ CalcularDV(cadenaConcatenada: string?): string?</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">+ Desencriptar(textoEncriptado: string?): string?</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">+ Encriptar(textoPlano: string?): string?</TD></TR></TABLE>>];
n1 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#8493a5"><TR><TD BGCOLOR="#e3f3f4" ALIGN="CENTER"><FONT POINT-SIZE="10">static</FONT><BR/><B>HashHelper</B></TD></TR><HR/><TR><TD ALIGN="LEFT" CELLPADDING="4">+ ObtenerHashSHA256(texto: string): string</TD></TR></TABLE>>];
n2 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#8493a5"><TR><TD BGCOLOR="#e3f3f4" ALIGN="CENTER"><FONT POINT-SIZE="10">clase</FONT><BR/><B>IdiomaManager</B></TD></TR><HR/><TR><TD ALIGN="LEFT" CELLPADDING="4">+ IdiomaActual: Idioma?</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">- _instancia: IdiomaManager</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">- _observadores: List&lt;IIdiomaObserver&gt;</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">- _traducciones: Dictionary&lt;string, string&gt;</TD></TR><HR/><TR><TD ALIGN="LEFT" CELLPADDING="4">+ CargarIdioma(idioma: Idioma, traducciones: Dictionary&lt;string,<BR ALIGN="LEFT"/>string&gt;): void</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">+ ClaveDe(nombreForm: string, nombreControl: string): string</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">+ Desuscribir(observador: IIdiomaObserver): void</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">+ NotificarObservadores(): void</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">+ ObtenerInstancia(): IdiomaManager</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">+ ReiniciarSesion(): void</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">+ Suscribir(observador: IIdiomaObserver): void</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">… otras operaciones en las propiedades de EA</TD></TR></TABLE>>];
n3 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#8493a5"><TR><TD BGCOLOR="#e3f3f4" ALIGN="CENTER"><FONT POINT-SIZE="10">interfaz</FONT><BR/><B>IIdiomaObserver</B></TD></TR><HR/><TR><TD ALIGN="LEFT" CELLPADDING="4">+ ActualizarIdioma(): void</TD></TR></TABLE>>];
n4 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#8493a5"><TR><TD BGCOLOR="#e3f3f4" ALIGN="CENTER"><FONT POINT-SIZE="10">interfaz</FONT><BR/><B>IIdiomaSubject</B></TD></TR><HR/><TR><TD ALIGN="LEFT" CELLPADDING="4">+ Desuscribir(observador: IIdiomaObserver): void</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">+ NotificarObservadores(): void</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">+ Suscribir(observador: IIdiomaObserver): void</TD></TR></TABLE>>];
n5 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#8493a5"><TR><TD BGCOLOR="#e3f3f4" ALIGN="CENTER"><FONT POINT-SIZE="10">clase</FONT><BR/><B>SesionServicio</B></TD></TR><HR/><TR><TD ALIGN="LEFT" CELLPADDING="4">+ EstaAutenticado: bool</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">+ UsuarioActual: Usuario?</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">- _instancia: SesionServicio?</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">- _lock: object</TD></TR><HR/><TR><TD ALIGN="LEFT" CELLPADDING="4">+ CerrarSesion(): void</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">+ IniciarSesion(usuarioLogueado: Usuario): void</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">+ ObtenerAutorCambio(): AutorCambioUsuario?</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">+ ObtenerInstancia(): SesionServicio</TD></TR></TABLE>>];
n6 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#8493a5"><TR><TD BGCOLOR="#e3f3f4" ALIGN="CENTER"><FONT POINT-SIZE="10">static</FONT><BR/><B>VerificadorSHA256</B></TD></TR><HR/><TR><TD ALIGN="LEFT" CELLPADDING="4">+ Base64(texto: string): string</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">+ Canonico(valores: object? []): string</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">+ Hexadecimal(texto: string): string</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">+ Usuario(idUsuario: int, nombreUsuario: string?, password: string?,<BR ALIGN="LEFT"/>nombre: string?, apellido: string?, activo: bool): string</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">+ UsuarioRol(idUsuario: int, idRol: int): string</TD></TR></TABLE>>];
n0 -> n1 -> n6 [style=invis, weight=0.1];
}
n2 -> n4 [arrowhead=empty, color="#334155", style=dashed];
n2 -> n2 [arrowhead=vee, label="_instancia"];
n2 -> n3 [arrowhead=vee, label="_observadores [0..*]"];
n4 -> n3 [style=dashed, arrowhead=open, color="#94a3b8", label="usa"];
n5 -> n5 [arrowhead=vee, label="_instancia"];
n5 -> n2 [style=dashed, arrowhead=open, color="#94a3b8", label="usa"];
}