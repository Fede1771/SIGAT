digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.55", ranksep="0.7", splines=polyline, dpi=72];
node [fontname="Arial", fontsize=12, color="#404040"];
edge [fontname="Arial", fontsize=9, color="#555555", arrowsize=0.8];
"FrmIntegridad" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>FrmIntegridad</B></TD></TR><TR><TD ALIGN="LEFT">-Operar(accion: Func&lt;string&gt;, mostrarRuta: bool): Task<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"IntegridadBLL" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>IntegridadBLL</B></TD></TR><TR><TD ALIGN="LEFT">+Verificar(): InformeIntegridad<BR ALIGN="LEFT"/>+PuedeAdministrar(): bool<BR ALIGN="LEFT"/>+InicializarBaseConfiable(): string<BR ALIGN="LEFT"/>+CrearRespaldoConfiable(destino: string): string<BR ALIGN="LEFT"/>+ArchivarBitacora(dias: int): int<BR ALIGN="LEFT"/>+Recuperar(ruta: string, tablasCompletas: bool): InformeIntegridad<BR ALIGN="LEFT"/>+ExigirIntegridad(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"IntegridadDAL" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>IntegridadDAL</B></TD></TR><TR><TD ALIGN="LEFT"><U>-Examinar(c: SqlConnection, t: SqlTransaction): Estado</U><BR ALIGN="LEFT"/>+Verificar(): InformeIntegridad<BR ALIGN="LEFT"/>+LeerVerificado(leer: Func&lt;SqlConnection, SqlTransaction, T&gt;): T<BR ALIGN="LEFT"/>+Cambiar(tabla: string, cambiar: Func&lt;SqlConnection, SqlTransaction, T&gt;): T<BR ALIGN="LEFT"/>+InicializarBaseConfiable(): string<BR ALIGN="LEFT"/>+CrearRespaldoConfiable(destino: string): string<BR ALIGN="LEFT"/>+Recuperar(ruta: string, restaurarTablasCompletas: bool): InformeIntegridad<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"InformeIntegridad" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>InformeIntegridad</B></TD></TR><TR><TD ALIGN="LEFT">+Configurada: bool<BR ALIGN="LEFT"/>+Problemas: List&lt;ProblemaIntegridad&gt;<BR ALIGN="LEFT"/>+Correcta: bool<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ProblemaIntegridad" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>ProblemaIntegridad</B></TD></TR><TR><TD ALIGN="LEFT">+Tabla: string<BR ALIGN="LEFT"/>+Registro: string<BR ALIGN="LEFT"/>+Motivo: string<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"IntegridadException" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>IntegridadException</B></TD></TR><TR><TD ALIGN="LEFT">+Informe: InformeIntegridad<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"VerificadorSHA256" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>VerificadorSHA256</B><BR/>«static»</TD></TR><TR><TD ALIGN="LEFT"><U>+Canonico(valores: Object[]): string</U><BR ALIGN="LEFT"/><U>+Hexadecimal(texto: string): string</U><BR ALIGN="LEFT"/><U>+Base64(texto: string): string</U><BR ALIGN="LEFT"/><U>+Traduccion(idioma: int, control: int, texto: string, estado: string): string</U><BR ALIGN="LEFT"/><U>+Bitacora(id: int, fecha: DateTime, usuario: string, actividad: string, cifrado: string): string</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"EncriptadorServicio" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>EncriptadorServicio</B></TD></TR><TR><TD ALIGN="LEFT">+Encriptar(textoPlano: string): string<BR ALIGN="LEFT"/>+Desencriptar(textoEncriptado: string): string<BR ALIGN="LEFT"/>+CalcularDV(cadenaConcatenada: string): string<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"IntegridadBLL" -> "IntegridadDAL" [arrowhead=vee,label="dal",taillabel="1",headlabel="1"];
"FrmIntegridad" -> "IntegridadBLL" [arrowhead=vee,label="servicio",taillabel="1",headlabel="1"];
"FrmIntegridad" -> "InformeIntegridad" [arrowhead=vee,label="informe",taillabel="1",headlabel="1"];
"InformeIntegridad" -> "ProblemaIntegridad" [arrowhead=vee,label="Problemas",taillabel="1",headlabel="0..*"];
"IntegridadException" -> "InformeIntegridad" [arrowhead=vee,label="Informe",taillabel="1",headlabel="1"];
"IntegridadDAL" -> "VerificadorSHA256" [arrowhead=vee,style=dashed,label="DVH y DVV"];
"IntegridadDAL" -> "EncriptadorServicio" [arrowhead=vee,style=dashed,label="validar cifrado"];
}