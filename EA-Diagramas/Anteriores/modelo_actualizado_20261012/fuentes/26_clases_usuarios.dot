"Usuario" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#edf2f7"><B>Usuario</B></TD></TR><TR><TD ALIGN="LEFT">+EsAdministradorOriginal: bool<BR ALIGN="LEFT"/>+Id: int<BR ALIGN="LEFT"/>+Roles: List&lt;Rol&gt;<BR ALIGN="LEFT"/>+IdUsuario: int<BR ALIGN="LEFT"/>+NombreUsuario: string<BR ALIGN="LEFT"/>+Password: string<BR ALIGN="LEFT"/>+Nombre: string<BR ALIGN="LEFT"/>+Apellido: string<BR ALIGN="LEFT"/>+Activo: bool<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+AsignarRol(r: Rol): void<BR ALIGN="LEFT"/>+QuitarRol(r: Rol): void<BR ALIGN="LEFT"/>+TienePermiso(nombre: string): bool<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
